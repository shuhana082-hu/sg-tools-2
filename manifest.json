{
  "manifest_version": 3,
  "name": "Site Capture",
  "version": "1.0",
  "description": "Turn on, browse any site, and every file it loads (images, video, fonts, sounds, API responses) is saved. ZIP and download when done.",
  "permissions": ["storage", "downloads", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": { "128": "icon.png" }
}
